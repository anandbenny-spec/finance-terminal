# Copy to .env on the Mac (never committed). In production these are GitHub Actions and Vercel secrets.
# Names only here; values never go into the repo or a chat.

# --- Jobs (GitHub Actions secrets) ---
JOB_DATABASE_URL=postgresql://job_writer.<project-ref>:<password>@<pooler-host>:5432/postgres   # shared pooler, session mode
#   the runner adds TCP keepalives itself (60 s idle, 15 s interval, 4 probes), so the URL needs none (Review 01, F3)
STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3                     # R2 later: https://<account>.r2.cloudflarestorage.com
STORAGE_BUCKET=raw
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=ap-south-1                                                                     # R2: auto
FRED_API_KEY=
COINGECKO_DEMO_KEY=               # CoinGecko's free Demo API key (sent in a header, never in a URL)
SEC_USER_AGENT=
ANTHROPIC_API_KEY=                # scoped to the Claude Console's Default workspace
VOYAGE_API_KEY=                   # a MongoDB Atlas model API key (unscoped): the client routes it to ai.mongodb.com/v1

# --- Vercel, api service (server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SQL_READER_DATABASE_URL=postgresql://sql_reader.<project-ref>:<password>@<pooler-host>:6543/postgres  # transaction mode
GITHUB_DISPATCH_TOKEN=            # fine-grained, Actions: write, this repo only, with an expiry date
VISITOR_HASH_SALT=

# --- Vercel, web service (public by design) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mac on campus Wi-Fi (Sophos), after 26 Oct ---
UV_SYSTEM_CERTS=true              # uv trusts the macOS certificate store
NODE_EXTRA_CA_CERTS=              # path to the exported Sophos root certificate (PEM), for npm and the Vercel CLI
