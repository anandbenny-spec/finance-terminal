// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChangeStrip markup, pinned > both banks, with a footer and a refresh list 1`] = `"<section aria-labelledby="panel-change-strip" class="col-span-1 flex min-w-0 flex-col overflow-hidden rounded-md border border-line-strong bg-panel md:col-span-12"><div class="flex h-10 shrink-0 items-center gap-2 border-b border-line-strong bg-raised pr-2 pl-3"><h3 id="panel-change-strip" class="truncate text-data font-semibold text-ink-1">How much each statement changed</h3><div class="ml-auto flex items-center gap-0.5"><button type="button" aria-pressed="false" aria-label="View as table" title="View as table" class="grid size-7 place-items-center rounded-md text-ink-2 hover:bg-active hover:text-ink-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-table-2 size-4" aria-hidden="true"><path d="M3 9h18"></path><path d="M9 3v18"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg></button></div></div><p class="px-3 pt-2 text-ink-2 pb-2">Which statements were rewritten the most? Each bar is the share of a statement&#x27;s words added (above the line) and removed (below), against the statement before it.</p><div class="min-w-0 flex-1 p-0"><div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-3 pt-2.5 text-data text-ink-2"><span class="inline-flex items-center gap-1.5"><i aria-hidden="true" class="inline-block h-2 w-3.5 bg-ins-ink"></i>Words added</span><span class="inline-flex items-center gap-1.5"><i aria-hidden="true" class="inline-block h-2 w-3.5 bg-del-ink"></i>Words removed</span><span class="inline-block rounded-sm border border-dashed border-line-strong px-1.5 font-sans whitespace-nowrap text-ink-2">share of words, derived</span></div><div class="px-3 pt-2.5 pb-1"><div class="mb-1 flex flex-wrap items-baseline gap-x-4 gap-y-1"><h4 class="text-meta font-medium text-ink-2">Fed (FOMC statements)</h4><span aria-live="polite"><span class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-data text-ink-2"><span class="font-mono text-ink-3">18 Mar 2026</span><span><b class="font-semibold text-ink-1">+20.0%</b> added<span class="text-ink-3"> (100 of 500 words)</span></span><span><b class="font-semibold text-ink-1">−12.5%</b> removed<span class="text-ink-3"> (50 of 400 words)</span></span><a class="text-ink-1 underline" href="/policy/fed/2026-03-18/changes">Open what changed</a></span></span></div><div role="group" tabindex="0" aria-label="Fed: share of each statement&#x27;s words added and removed, by meeting. Left and right arrow keys choose a meeting; Enter opens it. View as table lists them all." class="rounded-sm"><div class="h-40 w-full" aria-hidden="true"></div></div></div><div class="px-3 pt-2.5 pb-1"><div class="mb-1 flex flex-wrap items-baseline gap-x-4 gap-y-1"><h4 class="text-meta font-medium text-ink-2">RBI (MPC resolutions)</h4><span aria-live="polite"><span class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-data text-ink-2"><span class="font-mono text-ink-3">8 Apr 2026</span><span><b class="font-semibold text-ink-1">+12.9%</b> added<span class="text-ink-3"> (90 of 700 words)</span></span><span><b class="font-semibold text-ink-1">−1.7%</b> removed<span class="text-ink-3"> (10 of 600 words)</span></span><a class="text-ink-1 underline" href="/policy/rbi/2026-04-08/changes">Open what changed</a></span></span></div><div role="group" tabindex="0" aria-label="RBI: share of each statement&#x27;s words added and removed, by meeting. Left and right arrow keys choose a meeting; Enter opens it. View as table lists them all." class="rounded-sm"><div class="h-40 w-full" aria-hidden="true"></div></div></div></div><div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-1 border-t border-line px-3 py-2 text-meta text-ink-3"><span>Source line</span></div></section>"`;

exports[`ChangeStrip markup, pinned > one bank with bars and meetings without a bar, the other with no bar at all 1`] = `"<section aria-labelledby="panel-change-strip" class="col-span-1 flex min-w-0 flex-col overflow-hidden rounded-md border border-line-strong bg-panel md:col-span-12"><div class="flex h-10 shrink-0 items-center gap-2 border-b border-line-strong bg-raised pr-2 pl-3"><h3 id="panel-change-strip" class="truncate text-data font-semibold text-ink-1">How much each statement changed</h3><div class="ml-auto flex items-center gap-0.5"><button type="button" aria-pressed="false" aria-label="View as table" title="View as table" class="grid size-7 place-items-center rounded-md text-ink-2 hover:bg-active hover:text-ink-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-table-2 size-4" aria-hidden="true"><path d="M3 9h18"></path><path d="M9 3v18"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg></button></div></div><p class="px-3 pt-2 text-ink-2 pb-2">Which statements were rewritten the most? Each bar is the share of a statement&#x27;s words added (above the line) and removed (below), against the statement before it.</p><div class="min-w-0 flex-1 p-0"><div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-3 pt-2.5 text-data text-ink-2"><span class="inline-flex items-center gap-1.5"><i aria-hidden="true" class="inline-block h-2 w-3.5 bg-ins-ink"></i>Words added</span><span class="inline-flex items-center gap-1.5"><i aria-hidden="true" class="inline-block h-2 w-3.5 bg-del-ink"></i>Words removed</span><span class="inline-block rounded-sm border border-dashed border-line-strong px-1.5 font-sans whitespace-nowrap text-ink-2">share of words, derived</span></div><div class="px-3 pt-2.5 pb-1"><div class="mb-1 flex flex-wrap items-baseline gap-x-4 gap-y-1"><h4 class="text-meta font-medium text-ink-2">Fed (FOMC statements)</h4><span aria-live="polite"><span class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-data text-ink-2"><span class="font-mono text-ink-3">28 Jan 2026</span><span><b class="font-semibold text-ink-1">+10.0%</b> added<span class="text-ink-3"> (40 of 400 words)</span></span><span><b class="font-semibold text-ink-1">−5.0%</b> removed<span class="text-ink-3"> (20 of 400 words)</span></span><a class="text-ink-1 underline" href="/policy/fed/2026-01-28/changes">Open what changed</a></span></span></div><div role="group" tabindex="0" aria-label="Fed: share of each statement&#x27;s words added and removed, by meeting. Left and right arrow keys choose a meeting; Enter opens it. View as table lists them all." class="rounded-sm"><div class="h-40 w-full" aria-hidden="true"></div></div><p class="pt-1 text-meta text-ink-3">1 of 2 Fed meetings has no bar: nothing earlier to compare with, or the comparison isn&#x27;t stored.</p></div><div class="px-3 pt-2.5 pb-1"><div class="mb-1 flex flex-wrap items-baseline gap-x-4 gap-y-1"><h4 class="text-meta font-medium text-ink-2">RBI (MPC resolutions)</h4><span aria-live="polite"></span></div><span class="inline-flex items-center gap-1.5 text-ink-2" data-state-kind="unavailable"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-3.5 shrink-0 text-ink-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><span>No MPC resolution has a stored comparison with the one before it yet.</span></span></div></div></section>"`;

exports[`ChangeStrip markup, pinned > the all-empty panel 1`] = `"<section aria-labelledby="panel-change-strip" class="col-span-1 flex min-w-0 flex-col overflow-hidden rounded-md border border-line-strong bg-panel md:col-span-12"><div class="flex h-10 shrink-0 items-center gap-2 border-b border-line-strong bg-raised pr-2 pl-3"><h3 id="panel-change-strip" class="truncate text-data font-semibold text-ink-1">How much each statement changed</h3></div><p class="px-3 pt-2 text-ink-2 pb-2">Which statements were rewritten the most? Each bar is the share of a statement&#x27;s words added (above the line) and removed (below), against the statement before it.</p><div class="min-w-0 flex-1 p-0"><div class="p-3"><span class="inline-flex items-center gap-1.5 text-ink-2" data-state-kind="unavailable"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-3.5 shrink-0 text-ink-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><span>No statement has a stored comparison with the one before it yet.</span></span></div></div></section>"`;
